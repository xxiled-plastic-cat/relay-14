{
  "name": "relay-14",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["15 * * * *"]
  },
  "routes": [
    {
      "pattern": "relay-14-facilitator.compx.io",
      "custom_domain": true
    }
  ],
  "vars": {
    "CHAIN_ID": "4441",
    "RPC_URL": "https://liteforge.rpc.caldera.xyz/http",
    "NETWORK": "litvm-testnet",
    "NF_STATS_URL": "https://nf-stats-upload.kierantnelson.workers.dev/upload/relay-14"
  },
  "d1_databases": [
    {
      "binding": "RELAY14",
      "database_name": "relay-14",
      "database_id": "eb5d0d0b-5bc2-4716-8bed-0931f91ce64c",
      "migrations_dir": "migrations"
    }
  ]
}
